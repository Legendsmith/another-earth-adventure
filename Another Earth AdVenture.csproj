<Project Sdk="Godot.NET.Sdk/4.7.0-limboai-v1.8.0.gha">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AnotherEarth</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- The orbital solvers integrate hundreds of thousands of steps; unoptimised Debug code is ~4x slower. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
